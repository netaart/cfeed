{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cfeed",
  "account_id": "ddf758a65bc0facafedd2e661b51a646",
  "compatibility_date": "2025-08-03",
  "main": "./src/worker/index.ts",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "cfeed.neta.art", "custom_domain": true }],
  "assets": {
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfeed",
      "database_id": "22b563c7-d1b7-42a6-9fdc-0206a26d51bc",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "cfeed-attachments" }
  ],
  "ratelimits": [
    {
      "name": "SUBMIT_LIMITER",
      "namespace_id": "470301",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "MAX_CONTENT_CHARS": "10000",
    "MAX_EXTRA_BYTES": "16384",
    "DEFAULT_MAX_FILES": "5",
    "DEFAULT_MAX_FILE_BYTES": "10485760",
    "DEFAULT_ALLOWED_MIME": "image/png,image/jpeg,image/webp,image/gif,video/mp4,video/webm,text/plain,application/json,application/pdf,application/zip"
  }
  // Secrets (set via `wrangler secret put`; locally in .dev.vars):
  //   ADMIN_TOKEN - admin console and unrestricted queries
  //   IP_SALT     - HMAC key for ip_hash
}
